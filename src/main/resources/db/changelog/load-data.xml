<databaseChangeLog
 xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
 xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
 xsi:schemaLocation="
  http://www.liquibase.org/xml/ns/dbchangelog
  http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

 <changeSet id="2" author="asish">

  <loadData
    file="classpath:inventory.csv"
    tableName="inventory_batch"
    separator=",">

   <column name="batch_id" index="1"/>
   <column name="product_id" index="2"/>
   <column name="product_name" index="3"/>
   <column name="quantity" index="4"/>
   <column name="expiry_date" index="5"/>

  </loadData>

 </changeSet>

</databaseChangeLog>
